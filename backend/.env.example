NODE_ENV=production
PORT=5000
APP_BASE_URL=https://api.your-domain.com
ORDERING_WEB_URL=https://order.your-domain.com

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/bookfood
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Required in production. Separate multiple web origins with commas.
CORS_ORIGINS=https://app.example.com,https://admin.example.com
TRUST_PROXY=1

# Limits are per IP for each 15-minute window.
GENERAL_RATE_LIMIT=600
AUTH_RATE_LIMIT=20
PUBLIC_ORDER_RATE_LIMIT=100

# Choose ONE Firebase credential method. Never commit the service-account file.
# A) Mounted secret file / local development:
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# B) Hosting dashboard secret (base64 of the complete service-account JSON):
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# C) Inline JSON secret:
# FIREBASE_SERVICE_ACCOUNT_JSON=
